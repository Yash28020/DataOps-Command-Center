# ========================================================
# DATAOPS COMMAND CENTER - ENVIRONMENT CONFIGURATION
# ========================================================

# Application Mode: development | production | test
ENVIRONMENT=development

# Database Connection:
# Primary Enterprise Target (PostgreSQL):
# DATABASE_URL=postgresql://dataops_user:dataops_secure_password_2026@localhost:5432/dataops_db
# Local Fallback (SQLite Persistent File):
DATABASE_URL=sqlite:///./dataops.db

# Storage Limits
MAX_UPLOAD_SIZE_MB=50
DEFAULT_RECON_TOLERANCE=0.05

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
